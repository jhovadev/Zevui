{
  "name": "@zevui/cli",
  "version": "0.2.0",
  "description": "Native Zig 0.17.1 CLI to install source-owned DVUI components",
  "type": "module",
  "bin": { "zevui": "./bin/zevui.mjs" },
  "engines": { "node": ">=20" },
  "files": ["bin/", "src/", "registry.json", "registry-bundle.json", "README.md", "LICENSE", "SKILL.md"],
  "scripts": {
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "test": "node --test test/*.test.mjs",
    "prepack": "node scripts/build-registry.mjs --check"
  },
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "keywords": ["zig", "dvui", "components", "cli", "zevui", "shadcn", "native"]
}
