{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zevui registry metadata / channel 0.17",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "registryVersion", "channel", "supportedZig", "packages", "addons"],
  "properties": {
    "schemaVersion": {"const": 1},
    "registryVersion": {"type": "string"},
    "channel": {"const": "0.17"},
    "supportedZig": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "packages": {"type": "object"},
    "addons": {"type": "array", "items": {"$ref": "addon.schema.json"}}
  }
}
